# Copy to keystore.properties in the repository root; keep the real file private.
# Relative storeFile paths are resolved from the repository root.
storeFile=.signing/betteryamf.p12
storeType=PKCS12
storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyAlias=betteryamf
keyPassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
